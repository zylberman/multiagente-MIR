# Backend used by every agent unless an agent-specific override is set.
# Supported values: mock, groq, openai_compatible
MIR_LLM_PROVIDER=mock
MIR_LLM_MODEL=deterministic-demo

# Remote Groq provider. Never commit a real value.
GROQ_API_KEY=

# OpenAI-compatible endpoint, for example LM Studio.
MIR_LLM_BASE_URL=http://localhost:1234/v1
MIR_LLM_API_KEY=local-development-only

# Optional per-agent model overrides.
MIR_ANSWER_MODEL=
MIR_PHARMACOLOGY_MODEL=
MIR_CLINICAL_MODEL=
MIR_TERMINOLOGY_MODEL=
MIR_MNEMONIC_MODEL=

MIR_LOG_LEVEL=INFO
